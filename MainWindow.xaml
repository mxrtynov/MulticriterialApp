<Window x:Class="MulticriterialApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MulticriterialApp.ViewModels"
        Title="Многокритериальный выбор — метод ЭЛЕКТРА"
        Height="860" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentDark" Color="#1E40AF"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#D6DEEA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="GreenSoft" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="GreenEdge" Color="#10B981"/>
        <SolidColorBrush x:Key="GreenText" Color="#065F46"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="10" ShadowDepth="1" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderText}"
                           Text="Выбор площадки под химическое предприятие"/>
                <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,0"
                           Text="Методы: Парето → веса критериев (метод ранга) → ЭЛЕКТРА I"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   Text="Исходные данные (оценки альтернатив)"/>
                        <DataGrid ItemsSource="{Binding AltsView}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Альтернатива" Binding="{Binding [0]}" Width="120"/>
                                <DataGridTextColumn Header="K1 Условия доставки" Binding="{Binding [1]}" Width="*"/>
                                <DataGridTextColumn Header="K2 Затраты на подготовку" Binding="{Binding [2]}" Width="*"/>
                                <DataGridTextColumn Header="K3 Опасность загрязнения" Binding="{Binding [3]}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Пороговые значения"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Индекс согласия c*" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TxtC}"
                                       Width="60" TextAlignment="Right"
                                       FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        </Grid>

                        <Slider Minimum="0.3" Maximum="0.95"
                                Value="{Binding C, Mode=TwoWay}"
                                TickFrequency="0.05"/>

                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Индекс несогласия d*" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TxtD}"
                                       Width="60" TextAlignment="Right"
                                       FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        </Grid>

                        <Slider Minimum="0.0" Maximum="1.0"
                                Value="{Binding D, Mode=TwoWay}"
                                TickFrequency="0.05"/>

                        <TextBlock Text="{Binding HintText}" Foreground="#B45309"
                                   FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Веса критериев">
                        <DataGrid ItemsSource="{Binding WeightsView}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Критерий" Binding="{Binding [0]}" Width="*"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding [1]}" Width="60"/>
                                <DataGridTextColumn Header="Эксперт 1" Binding="{Binding [2]}" Width="90"/>
                                <DataGridTextColumn Header="Эксперт 2" Binding="{Binding [3]}" Width="90"/>
                                <DataGridTextColumn Header="Итоговый вес" Binding="{Binding [4]}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Матрица согласия">
                        <DataGrid ItemsSource="{Binding MatrixCView}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="a \ b" Binding="{Binding [0]}" Width="70"/>
                                <DataGridTextColumn Header="П1" Binding="{Binding [1]}" Width="*"/>
                                <DataGridTextColumn Header="П2" Binding="{Binding [2]}" Width="*"/>
                                <DataGridTextColumn Header="П4" Binding="{Binding [3]}" Width="*"/>
                                <DataGridTextColumn Header="П5" Binding="{Binding [4]}" Width="*"/>
                                <DataGridTextColumn Header="П6" Binding="{Binding [5]}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Матрица несогласия">
                        <DataGrid ItemsSource="{Binding MatrixDView}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="a \ b" Binding="{Binding [0]}" Width="70"/>
                                <DataGridTextColumn Header="П1" Binding="{Binding [1]}" Width="*"/>
                                <DataGridTextColumn Header="П2" Binding="{Binding [2]}" Width="*"/>
                                <DataGridTextColumn Header="П4" Binding="{Binding [3]}" Width="*"/>
                                <DataGridTextColumn Header="П5" Binding="{Binding [4]}" Width="*"/>
                                <DataGridTextColumn Header="П6" Binding="{Binding [5]}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Граф превосходства">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding DominancePairs}"
                                     FontFamily="Consolas" FontSize="12"
                                     BorderBrush="{StaticResource BorderSoft}"
                                     BorderThickness="1"/>
                            <Canvas Grid.Column="1" x:Name="GraphCanvas"
                                    Background="#F8FAFC"
                                    ClipToBounds="True"
                                    SizeChanged="GraphCanvas_SizeChanged"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Рейтинг и результат">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding RankingView}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Альтернатива" Binding="{Binding [0]}" Width="*"/>
                                    <DataGridTextColumn Header="Исходящих" Binding="{Binding [1]}" Width="90"/>
                                    <DataGridTextColumn Header="Входящих" Binding="{Binding [2]}" Width="90"/>
                                    <DataGridTextColumn Header="Разница (out-in)" Binding="{Binding [3]}" Width="120"/>
                                    <DataGridTextColumn Header="Сумма C(a,*)" Binding="{Binding [4]}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1" Background="{StaticResource GreenSoft}"
                                    BorderBrush="{StaticResource GreenEdge}"
                                    BorderThickness="1"
                                    CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Лучшая альтернатива(ы):"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource GreenText}"/>
                                    <TextBlock Text="{Binding BestText}" FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource GreenText}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Подобрать пороги для 1–2 лучших"
                    Command="{Binding ExploreCommand}"/>
            <Button Content="Экспорт в .txt"
                    Click="BtnExport_Click"
                    Background="#059669"/>
            <Button Content="Сбросить"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource GhostButton}"/>
        </StackPanel>
    </Grid>
</Window>